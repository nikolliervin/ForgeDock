# Copy to .env, choose local credentials, and generate a token with: openssl rand -hex 32
POSTGRES_PASSWORD=replace-with-local-password
ConnectionStrings__ForgeDock='Host=localhost;Port=5432;Database=forgedock;Username=forgedock;Password=replace-with-local-password'
ForgeDock__ApiToken=replace-with-a-random-token-at-least-32-characters
# AUTHENTICATION: select one active mode; full setup instructions: docs/AUTHENTICATION.md.
# keycloak | oidc | entra | auth0 | okta | authentik | token
ForgeDock__Auth__Mode=token
# Recommended locally: run make keycloak; it sets Mode=keycloak and generates private values.
# ForgeDock__Keycloak__LocalEnabled=true
# SecondFactor: totp (phone app) or webauthn (security key/passkey).
# ForgeDock__Keycloak__SecondFactor=totp
# ForgeDock__Keycloak__HttpsPort=8444
# ForgeDock__Keycloak__DashboardPort=5443
# ForgeDock__Keycloak__Image=quay.io/keycloak/keycloak:26.8.0
# All SSO modes require these keys (token mode only requires ApiToken above):
# ForgeDock__Oidc__Authority=https://localhost:8444/realms/forgedock
# ForgeDock__Oidc__PublicOrigin=https://localhost:5443
# ForgeDock__Oidc__ClientId=forgedock
# ForgeDock__Oidc__ClientSecret=registered-confidential-client-secret
# ForgeDock__Oidc__AllowedSubjects__0=approved-immutable-subject-id
# ForgeDock__Oidc__AllowedSubjects__1=another-approved-subject-id
# Remote Keycloak: Authority=https://auth.example.com/realms/forgedock; LocalEnabled=false
# Generic OIDC: Authority=your-provider-issuer
# Entra: Authority=https://login.microsoftonline.com/TENANT-ID/v2.0 (app-specific sub)
# Auth0: Authority=https://TENANT.REGION.auth0.com/
# Okta: Authority=https://ORG.okta.com/oauth2/default
# authentik: Authority=https://auth.example.com/application/o/forgedock/
# Register PublicOrigin/api/auth/callback with the provider. Serve UI and /api on HTTPS.
# MFA/passkeys and recovery policies are enforced in the provider, not by selecting its name.
# SSO disables shared bearer-token authentication. Unknown modes fail startup.
# Google/GitHub/Microsoft social sign-in can be brokered through Keycloak; see the guide.
ASPNETCORE_URLS=http://127.0.0.1:5080
ForgeDock__SecretKey=replace-with-output-of-openssl-rand-base64-32
ForgeDock__RuntimePath=/absolute/path/to/deployra/.runtime
ForgeDock__WebRoot=/absolute/path/to/deployra/web/dist

# Optional overrides; defaults use the private runtime tools and local BuildKit container.
# ForgeDock__RailpackPath=/absolute/path/to/deployra/.runtime/tools/railpack
# ForgeDock__BuildKitHost=docker-container://forgedock-buildkit

# Public application domains (disabled for local development).
ForgeDock__Domains__Enabled=false
# ForgeDock__Domains__Target=deploy.example.com
# ForgeDock__Domains__Addresses=203.0.113.10
# ForgeDock__Domains__Email=ops@example.com
# Production: expose only the HTTPS edge on public ports; management stays on loopback.
# ForgeDock__Domains__BindAddress=0.0.0.0
# ForgeDock__Domains__HttpPort=80
# ForgeDock__Domains__HttpsPort=443
# Optional staging CA for testing (certificates will not be trusted by browsers):
# ForgeDock__Domains__AcmeDirectory=https://acme-staging-v02.api.letsencrypt.org/directory

# Optional private GitHub repository access (worker only).
# Use a fine-grained token scoped to selected repositories with Contents: Read-only.
# ForgeDock__GitHubToken=github_pat_replace_me

# Public HTTPS origin used for GitHub webhook setup links (API only).
# Configure a reverse proxy to forward only /api/webhooks/github/* to the API.
# ForgeDock__WebhookBaseUrl=https://hooks.example.com

# Notification log links must point to the dashboard, not the webhook-only tunnel.
# ForgeDock__DashboardBaseUrl=http://localhost:5173
# Optional existing/free SMTP service. Credentials are read by the worker only.
# ForgeDock__Smtp__Host=smtp.example.com
# ForgeDock__Smtp__Port=587
# ForgeDock__Smtp__EnableSsl=true
# ForgeDock__Smtp__From=deployments@example.com
# ForgeDock__Smtp__Username=deployments@example.com
# ForgeDock__Smtp__Password=replace_me

# Optional public PR previews. Configure wildcard DNS and public HTTPS hosting first.
# ForgeDock__PreviewBaseDomain=previews.example.com
# Successful backup files retained per managed service (1–100).
# ForgeDock__BackupRetentionCount=7

# Optional S3-compatible encrypted backup storage (worker only).
# Create a private bucket first. Use a prefix unique to this ForgeDock instance.
# ForgeDock__BackupS3__Enabled=true
# ForgeDock__BackupS3__Endpoint=https://s3.us-east-1.amazonaws.com
# ForgeDock__BackupS3__Region=us-east-1
# ForgeDock__BackupS3__Bucket=my-forgedock-backups
# ForgeDock__BackupS3__Prefix=forgedock
# ForgeDock__BackupS3__AccessKey=replace_me
# ForgeDock__BackupS3__SecretKey=replace_me
# Local copies retained after upload (0–100; defaults to BackupRetentionCount).
# ForgeDock__BackupLocalRetentionCount=2
# HTTP is only for testing an isolated local S3-compatible server.
# ForgeDock__BackupS3__AllowHttp=false
