<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\ForgeDock.Application\ForgeDock.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.1" />
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="../../examples/templates/**/*" Exclude="../../examples/templates/**/node_modules/**;../../examples/templates/**/bin/**;../../examples/templates/**/obj/**;../../examples/templates/**/dist/**;../../examples/templates/**/.next/**">
      <LogicalName>ForgeDock.Template.%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
